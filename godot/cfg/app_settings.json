{
  "application": {
    "name": "Drop App",
    "version": "0.0.1",
    "description": "GoDot front end app for Drop OSS"
  },
  "authentication": {
    "client": {
      "client_token": "encrypted_server_generated_token",
    },
    "admin": {
      "admin_token": "encrypted_server_generated_token",
    }
  },
  "server": {
    "base_url": "http://localhost",
    "port": 3000,
    "api_version": "v1",
    "endpoints": {
      "auth": "/api/v1/auth",
      "users": "/api/v1/users",
      "data": "/api/v1/data"
    }
  },
  "connection": {
    "timeout": 30000,
    "retry_attempts": 3,
    "retry_delay": 1000
  },
  "logging": {
    "level": "info",
    "file_path": "/var/log/myapp/app.log"
  }
}
