{
	"application": {
		"description": "GoDot front end app for Drop OSS",
		"name": "Drop App",
		"version": "0.0.1"
	},
	"authentication": {
		"admin_token": "encrypted_server_generated_token",
		"client_token": ""
	},
	"connection": {
		"retry_attempts": 3.0,
		"retry_delay": 1000.0,
		"timeout": 3000.0
	},
	"logging": {
		"file_path": "logs/app.log",
		"level": "info"
	},
	"server": {
		"api_version": "v1",
		"base_url": "http://localhost",
		"endpoints": {
			"admin_auth": "/api/v1/admin/auth",
			"admin_company": "/api/v1/admin/company",
			"admin_game": "/api/v1/admin/game",
			"admin_import": "/api/v1/admin/import",
			"admin_library": "/api/v1/admin/library",
			"admin_news": "/api/v1/admin/news",
			"admin_settings": "/api/v1/admin/settings",
			"admin_store": "/api/v1/admin/store",
			"admin_tags": "/api/v1/admin/tags",
			"admin_task": "/api/v1/admin/task",
			"admin_token": "/api/v1/admin/token",
			"admin_users": "/api/v1/admin/usesr",
			"auth": "/api/v1/auth",
			"client": "/api/v1/client",
			"collection": "/api/v1/collection",
			"companies": "/api/v1/companies",
			"games": "/api/v1/games",
			"news": "/api/v1/news",
			"notifications": "/api/v1/notifications",
			"object": "/api/v1/object",
			"screenshots": "/api/v1/screenshots",
			"settings": "/api/v1/settings",
			"store": "/api/v1/store",
			"tags": "/api/v1/tags",
			"task": "/api/v1/task",
			"user": "/api/v1/user"
		},
		"port": 3000.0
	}
